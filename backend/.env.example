# Copy to `.env` in this folder and adjust values.
#
# MySQL database name is set in config/config.json (refex_airport).
# Backend creates the database automatically on start if it does not exist.

# Required in production — JWT signing for /auth/login and /api/admin
APP_KEY=your-secret-app-key-here

# Optional: used for some API flows
# API_KEY=

# Optional: default password when creating users via API
# DEFAULT_PASSWORD=

# Wall sign-in: default password for new wall users (falls back to DEFAULT_PASSWORD)
# WALL_DEFAULT_PASSWORD=RefexWall2026!

# SMTP (Gmail — contact form + Wall forgot-password)
# Use a Gmail App Password, not the normal login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail-or-workspace-user@yourdomain.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_EMAIL=your-gmail-or-workspace-user@yourdomain.com
CONTACT_FORM_TO=bdrefexairport@refex.co.in
# Legacy aliases (optional): SMTP_PASS, SMTP_FROM

# Optional: override MySQL from config/config.json
# If seed fails with getaddrinfo EAI_AGAIN mysql, set DB_HOST to 127.0.0.1
# (or run the seed inside the Docker network where hostname "mysql" exists).
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=refex_airport

# Base URL for wall password reset links (falls back to request Origin, then http://localhost:3000)
# WALL_FRONT_END_URL=http://localhost:3000
